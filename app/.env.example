# Copy to app/.env and fill in. Never commit app/.env.

# Gemini (free tier from https://aistudio.google.com). Optional: without it
# commands are parsed by keyword rules only.
GEMINI_API_KEY=

# Comma-separated models, tried in order; the next one is used if a model's
# free-tier quota is exhausted (429) or it has been retired (404). Defaults
# to "gemini-3.6-flash,gemini-flash-lite-latest" when unset.
GEMINI_MODELS=

# REST API that serves the ten models (see api/)
API_BASE_URL=http://localhost:8000
