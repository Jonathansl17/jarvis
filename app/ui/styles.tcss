/* JarvisTEC TUI — tokens and layout from app-design.md §3-4. Dark palette
   only (per §10, ship dark-only rather than half-test light mode). */

Screen {
    background: #0C0F0A;
    color: #D8E3D3;
    layout: vertical;
}

#top-region {
    height: 1fr;
}

#left-pane {
    width: 26;
    height: 100%;
}

AvatarPane {
    width: 26;
    height: 16;
    border: round #3A4238;
    padding: 1;
    background: #12160F;
    content-align: center top;
}

AvatarPane.active {
    border: heavy #59F2C4;
}

CameraPreview {
    width: 26;
    height: 14;
    border: round #3A4238;
    background: #12160F;
    content-align: center middle;
}

ConversationLog {
    width: 1fr;
    height: 100%;
    border: round #3A4238;
    padding: 1;
    background: #12160F;
    color: #D8E3D3;
}

#input-line {
    height: 3;
    border: round #3A4238;
    background: #12160F;
    color: #D8E3D3;
}

#input-line:disabled {
    color: #8A9385;
}

StatusBar {
    height: 2;
    dock: bottom;
    border-top: solid #3A4238;
    background: #0C0F0A;
    color: #8A9385;
}
